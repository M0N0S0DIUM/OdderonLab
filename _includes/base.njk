<!DOCTYPE html>
<html lang="en">
<head>
  {% set siteUrl = "https://www.odderonlab.com" %}
  {% set fullTitle = "Odderon Lab" if page.url == "/" else title ~ " | Odderon Lab" %}
  {% set resolvedCanonical = canonical or (siteUrl ~ page.url) %}
  {% set socialImagePath = image or "/images/power-checker-hero.jpg" %}
  {% set socialImageUrl = siteUrl ~ socialImagePath %}
  {% set socialImageAlt = imageAlt or "Odderon Lab independent electronics lab" %}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0d0f0c">
  <meta name="color-scheme" content="dark">
  <title>{{ fullTitle }}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="canonical" href="{{ resolvedCanonical }}">
  <meta property="og:site_name" content="Odderon Lab">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ fullTitle }}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  <meta property="og:url" content="{{ resolvedCanonical }}">
  <meta property="og:image" content="{{ socialImageUrl }}">
  <meta property="og:image:alt" content="{{ socialImageAlt }}">
  {% if imageWidth %}<meta property="og:image:width" content="{{ imageWidth }}">{% endif %}
  {% if imageHeight %}<meta property="og:image:height" content="{{ imageHeight }}">{% endif %}
  {% if ogType == "article" and date %}<meta property="article:published_time" content="{{ date | dateToRfc3339 }}">{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ fullTitle }}">
  {% if description %}<meta name="twitter:description" content="{{ description }}">{% endif %}
  <meta name="twitter:image" content="{{ socialImageUrl }}">
  <meta name="twitter:image:alt" content="{{ socialImageAlt }}">
  <link rel="stylesheet" href="/styles.css?v=20260923-bench">
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=waveform-2">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png?v=waveform-2">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png?v=waveform-2">
  <link rel="icon" type="image/png" sizes="48x48" href="/images/favicon-48x48.png?v=waveform-2">
  <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64x64.png?v=waveform-2">
  <link rel="icon" type="image/png" sizes="128x128" href="/images/favicon-128x128.png?v=waveform-2">
  <link rel="icon" type="image/png" sizes="192x192" href="/images/favicon-192x192.png?v=waveform-2">
  <link rel="icon" type="image/png" sizes="512x512" href="/images/favicon-512x512.png?v=waveform-2">
  <link rel="icon" type="image/svg+xml" sizes="any" href="/images/odderon-logo.svg?v=2">
  <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png?v=waveform-2">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="alternate" type="application/atom+xml" title="Odderon Lab — Lab Notes" href="/feed.xml">
  <script>
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script defer src="/_vercel/insights/script.js"></script>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <nav class="nav" aria-label="Primary navigation">
    <div class="container nav-container">
      <div class="logo">
        <a href="/" class="brand-link">
          <img class="brand-mark" src="/images/odderon-logo.svg?v=2" width="36" height="36" alt="">
          <span>Odderon Lab</span>
        </a>
      </div>
      <div class="nav-links">
        <a href="/products/"{% if page.url == "/products/" or navSection == "products" %} aria-current="page"{% endif %}>Products</a>
        <a href="/labnotes/"{% if page.url == "/labnotes/" or navSection == "labnotes" %} aria-current="page"{% endif %}>Lab Notes</a>
        <a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a>
        <a href="/about/#contact">Contact</a>
      </div>
    </div>
  </nav>

  <main id="main-content" tabindex="-1">
    {{ content | safe }}
  </main>

  <footer>
    <div class="container footer-content">
      <p>Odderon Lab · {% year %}</p>
      <div class="footer-meta">
        <p class="footer-tagline">Independent electronics lab in Louisiana.</p>
        <a class="footer-contact" href="mailto:jacob@odderonlab.com">jacob@odderonlab.com</a>
      </div>
    </div>
  </footer>
</body>
</html>
