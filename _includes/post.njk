---
layout: base.njk
navSection: labnotes
ogType: article
---

<section class="container page-content">
  <article class="blog-post blog-post-single">
    <a class="post-back" href="/labnotes/">← All Lab Notes</a>

    <header class="post-header">
      <p class="eyebrow">Odderon Lab // Field Note</p>
      <h1>{{ title }}</h1>
      <time class="post-date" datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
    </header>

    <div class="post-body">
      {{ content | safe }}
    </div>

    <footer class="post-signoff">
      <span>— Odderon Lab</span>
      <a href="/labnotes/">Back to Lab Notes →</a>
    </footer>
  </article>
</section>
